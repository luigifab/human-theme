QMenuBar {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, /* horizontal */
		stop:0 /* @menubar_grad_top */ #F2F4F2,
		stop:1 /* @menubar_grad_bot */ #EEE9D5);
}

QMenu {
	background-color: #FFFFFF; /* @theme_base; */
}

QToolBar {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, /* horizontal */
		stop:0 /* @toolbar_grad_top */ #F2F4F2,
		stop:1 /* @toolbar_grad_bot */ #EEE9D5);
}
